# Raditomo Nginx 構成（本番）
#
# - HTTP は HTTPS にリダイレクト（Let's Encrypt の HTTP-01 チャレンジ用パスのみ素通し）
# - HTTPS で SPA / API プロキシ / HLS（auth_request 認証）を配信
# - 同一オリジンのため CORS は不要
# - HLS は /hls/{userId}/.../playlist.m3u8 形式で /data/recordings/{userId}/hls/... にマッピング
#
# このファイルは nginx 公式イメージの envsubst テンプレート機能で展開される。
# NGINX_ENVSUBST_FILTER=^APP_ により APP_ で始まる変数のみ置換され、
# nginx 内蔵変数（$host, $remote_addr 等）は置換されない。

# HTTP -> HTTPS（Let's Encrypt webroot のみ素通し）
server {
    listen 80;
    server_name ${APP_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS 本体
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/nginx/certs/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    client_max_body_size 4m;

    # SPA
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # API プロキシ。/api/internal/** は外部公開しない（Nginx 内部のサブリクエスト専用）。
    location ~ ^/api/internal/ {
        return 404;
    }
    location /api/ {
        proxy_pass http://app:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # HLS（認証必須）。
    # /hls/{userId}/{rest...} を /data/recordings/{userId}/hls/{rest...} にマッピング。
    # auth_request で /api/internal/auth-hls にサブリクエストして JWT を検証する。
    # フロントは hls.js の xhrSetup で Authorization ヘッダを毎リクエストに付与する。
    location ~ ^/hls/(\d+)/(.+)$ {
        auth_request /__internal_auth_hls;
        auth_request_set $auth_status $upstream_status;

        alias /data/recordings/$1/hls/$2;
        add_header Cache-Control "private, no-store" always;
        types {
            application/vnd.apple.mpegurl m3u8;
            video/mp2t                    ts;
            audio/mpeg                    mp3;
        }
    }

    # Nginx 内部のサブリクエスト用ロケーション。外部からは internal で阻止される。
    location = /__internal_auth_hls {
        internal;
        proxy_pass              http://app:8080/api/internal/auth-hls;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        X-Original-URI $request_uri;
        proxy_set_header        Authorization  $http_authorization;
    }
}
