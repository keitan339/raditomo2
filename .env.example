# Database
DB_PASSWORD=changeme

# JWT (256bit 以上のランダム文字列を本番では必ず設定)
JWT_SECRET=changeme_random_256bit_hex_string_at_least_32_chars

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=...
# SPA の /auth/callback がコードを受け取り、フロントから /api/auth/google/callback へ
# 中継する設計。Nginx 経由で同一オリジンなのでドメインだけ変えれば OK。
GOOGLE_OAUTH_REDIRECT_URI=https://raditomo.hidenv.com/auth/callback

# SMTP (Gmail アプリパスワード)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@gmail.com
SMTP_PASSWORD=app_password_here

# Radiko
RADIKO_DOWNLOAD_CONCURRENCY=8

# Domain
APP_BASE_URL=https://raditomo.hidenv.com
